# Copy to .env and fill in. Leave TAVILY_API_KEY empty (or MOCK=1) to run with invented sample data.
TAVILY_API_KEY=
ANTHROPIC_API_KEY=
MOCK=0

# Two models: a cheaper one reads pages, a stronger one writes the email
LLM_MODEL_CHEAP=claude-haiku-5-5
LLM_MODEL_SMART=claude-sonnet-5-5

# Cost estimates shown on the dashboard. Set these to the prices on your own plans.
SEARCH_COST_USD=0.008
LLM_IN_PER_MTOK=3
LLM_OUT_PER_MTOK=15

# Saved search/LLM answers expire after this many days. 0 = never (use for a frozen demo)
CACHE_TTL_DAYS=7

# Optional
MOCK_DELAY=0.6              # fake wait in mock mode so the live view is watchable
GOLDEN_FILE=golden.json     # test set; make golden_live.json with real, hand-checked people
